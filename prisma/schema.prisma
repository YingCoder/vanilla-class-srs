generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum CardSetStatus {
  PRIVATE      // visible only to creating teacher
  DEPARTMENTAL // visible to all teachers in subjectGrade; admin-editable only
}

enum AssignmentType {
  MANDATORY // all students in class get CardInstances created automatically
  OPTIONAL  // students can choose to add to their deck
}

enum CardOrigin {
  TEACHER_ASSIGNED // arrived via mandatory assignment
  OPTIONAL         // student opted into an optional CardSet
  STUDENT_ADDED    // student manually created
}

enum FSRSState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

// ─────────────────────────────────────────────
// Users & Auth
// ─────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid())
  // Login identity. Students are created with a teacher-assigned username and
  // may have no email; teachers/admins may log in with either. Both are unique
  // when present (Postgres allows multiple NULLs).
  username           String?   @unique
  email              String?   @unique
  passwordHash       String
  name               String
  role               Role      @default(STUDENT)
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  // Updated on both explicit POST /auth/login and silent POST /auth/refresh
  // (the latter fires roughly hourly during active use, since access tokens
  // expire after 1h) — this is what makes it a true "last active" signal
  // rather than just "last time they typed a password." Null = never logged in.
  lastLoginAt        DateTime?

  // Monotonic session generation. Bumped on password change/reset so every
  // refresh token issued before the change stops working immediately.
  sessionVersion     Int       @default(0)

  teacherProfile Teacher?
  studentProfile Student?

  // Password reset
  passwordResetTokens PasswordResetToken[]

  // Gamification ledger (source of truth for XP / coins)
  rewardEvents RewardEvent[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique // SHA-256 hash of the raw token sent by email (allows direct O(1) lookup)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// Organizational Structure
// ─────────────────────────────────────────────

model Department {
  id            String         @id @default(uuid())
  name          String
  createdAt     DateTime       @default(now())
  archivedAt    DateTime?
  subjectGrades SubjectGrade[]

  // Per-department label overrides shown everywhere a Card's L2/L1 definition is
  // labeled (admin, teacher, and student views). Null = use the default label
  // ("L2 Definition" / "L1 Definition").
  definitionL2Label String?
  definitionL1Label String?
}

model SubjectGrade {
  id                      String                   @id @default(uuid())
  name                    String                   // e.g. "English B HL Grade 12"
  departmentId            String
  department              Department               @relation(fields: [departmentId], references: [id])
  lead                    SubjectGradeLead?
  teachers                TeacherSubjectGrade[]
  classes                 Class[]
  cardSets                CardSet[]                // departmental CardSets live here
  subjectGradeAssignments SubjectGradeAssignment[]
  createdAt               DateTime                 @default(now())
  archivedAt              DateTime?
}

model Teacher {
  id            String                @id @default(uuid())
  userId        String                @unique
  user          User                  @relation(fields: [userId], references: [id])
  subjectGrades TeacherSubjectGrade[]
  classes       Class[]
  cardSets      CardSet[]             // teacher-owned CardSets
  createdAt     DateTime              @default(now())
}

model SubjectGradeLead {
  subjectGradeId String @id
  teacherId String
  subjectGrade SubjectGrade @relation(fields: [subjectGradeId], references: [id], onDelete: Restrict)
  membership TeacherSubjectGrade @relation(fields: [teacherId, subjectGradeId], references: [teacherId, subjectGradeId], onDelete: Restrict)

  @@unique([teacherId, subjectGradeId])
  @@index([teacherId])
}

model TeacherSubjectGrade {
  lead SubjectGradeLead?
  teacherId      String
  subjectGradeId String
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  subjectGrade   SubjectGrade @relation(fields: [subjectGradeId], references: [id])

  @@id([teacherId, subjectGradeId])
}

model Class {
  id              String                @id @default(uuid())
  name            String                // e.g. "Class 12A"
  teacherId       String
  teacher         Teacher               @relation(fields: [teacherId], references: [id])
  subjectGradeId  String
  subjectGrade    SubjectGrade          @relation(fields: [subjectGradeId], references: [id])
  enrollments     Enrollment[]
  assignments     Assignment[]
  homeworkReqs    HomeworkRequirement[]
  gameSetting     ClassGameSetting?
  challenges      ClassChallenge[]
  cheers          TeacherCheer[]
  analyticsEvents AnalyticsEvent[]
  squads          Squad[]
  season          ClassSeason?
  weeklyReports   WeeklyReport[]
  createdAt       DateTime              @default(now())
  archivedAt      DateTime?
}

// ─────────────────────────────────────────────
// Students & Enrollment
// ─────────────────────────────────────────────

model Student {
  id                String              @id @default(uuid())
  userId            String              @unique
  user              User                @relation(fields: [userId], references: [id])
  enrollments       Enrollment[]
  gameProfile       StudentGameProfile?
  gameEvents        GameEvent[]
  homeBuildings     StudentHomeBuilding[]
  dailyGameStates   DailyGameState[]
  badges            StudentBadge[]
  cheerReads        TeacherCheerRead[]
  analyticsEvents   AnalyticsEvent[]
  pushSubscriptions PushSubscription[]
  reminderPref      ReminderPref?
  reminderLogs      ReminderLog[]
  squadMembers      SquadMember[]
  squadCheers       SquadCheer[]
  createdAt         DateTime            @default(now())
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  classId   String
  student   Student  @relation(fields: [studentId], references: [id])
  class     Class    @relation(fields: [classId], references: [id])
  deck      Deck?
  // Personal CardSet — one per Enrollment, created lazily on first student card addition.
  // Do not use this field directly in application code to check for the personal set;
  // prefer querying CardSet where(enrollmentId, isPersonal: true) for clarity.
  personalCardSet CardSet? @relation("EnrollmentPersonalCardSet")
  joinedAt        DateTime @default(now())
  // Soft-delete: set when a teacher/admin unenrolls a student. Filtered out of
  // rosters and stats everywhere; review history and the deck are left intact
  // (reversible, unlike a hard delete).
  archivedAt      DateTime?
  dailyTasks      DailyStudyTask[]

  @@unique([studentId, classId])
}

// ─────────────────────────────────────────────
// Cards & CardSets
// ─────────────────────────────────────────────

model CardSet {
  id          String        @id @default(uuid())
  name        String        // e.g. "Unit 3 Vocabulary"
  description String?
  copiedFromId String?
  copiedFrom CardSet? @relation("CardSetCopies", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies CardSet[] @relation("CardSetCopies")
  status      CardSetStatus @default(PRIVATE)

  // Ownership: either teacher-owned or departmental (subjectGrade-owned)
  // When promoted to DEPARTMENTAL, teacherId is retained for attribution only.
  // Editing rights transfer to admin only after promotion.
  teacherId      String?       // original creator (attribution)
  teacher        Teacher?      @relation(fields: [teacherId], references: [id])
  subjectGradeId String?       // set when promoted to DEPARTMENTAL
  subjectGrade   SubjectGrade? @relation(fields: [subjectGradeId], references: [id])

  // Personal CardSet fields — only set for auto-created student personal sets
  isPersonal   Boolean     @default(false)
  enrollmentId String?     @unique // links personal CardSet to a specific Enrollment
  enrollment   Enrollment? @relation("EnrollmentPersonalCardSet", fields: [enrollmentId], references: [id])

  cards                   Card[]
  assignments             Assignment[]
  subjectGradeAssignments SubjectGradeAssignment[]
  homeworkRequirements    HomeworkRequirementCardSet[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  archivedAt              DateTime?

  @@unique([copiedFromId, subjectGradeId])
}

model Card {
  id        String  @id @default(uuid())
  cardSetId String
  cardSet   CardSet @relation(fields: [cardSetId], references: [id])

  // At least one of definitionL1 or definitionL2 must be non-null (enforced at app layer)
  word            String
  pos             String? // part of speech
  ipa             String? // phonetic transcription e.g. /bɪˈkɒz/
  definitionL2    String? // target language definition (e.g. English)
  definitionL1    String? // native language definition (e.g. Chinese)
  exampleSentence String? // teacher-provided example sentence
  mnemonic        Json?   // structured 邪修记忆 { tag, hook, story, chunks, trap, example }
  // Additional accepted spellings for grading (e.g. colour / color), spec §6.1.
  variants        String[] @default([])

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  instances CardInstance[]
}

// ─────────────────────────────────────────────
// Assignments
// ─────────────────────────────────────────────

model Assignment {
  id         String         @id @default(uuid())
  classId    String
  class      Class          @relation(fields: [classId], references: [id])
  cardSetId  String
  cardSet    CardSet        @relation(fields: [cardSetId], references: [id])
  type       AssignmentType
  priority   Int            @default(0) // lower = higher priority for new card introduction
  assignedAt DateTime       @default(now())
  assignedBy String         // userId of teacher or admin

  @@unique([classId, cardSetId])
}

// SubjectGradeAssignment — created by admin to push a CardSet to all teachers in a SubjectGrade.
// Teachers see these in their dashboard and then create Class-level Assignments from them.
// For MANDATORY: when teacher creates a Class Assignment, CardInstances auto-created for enrolled students.
// For OPTIONAL: when teacher opts the class in, CardSet appears in each student's available optional list.
model SubjectGradeAssignment {
  id             String         @id @default(uuid())
  subjectGradeId String
  subjectGrade   SubjectGrade   @relation(fields: [subjectGradeId], references: [id])
  cardSetId      String
  cardSet        CardSet        @relation(fields: [cardSetId], references: [id])
  type           AssignmentType
  assignedAt     DateTime       @default(now())
  assignedBy     String         // userId of admin

  @@unique([subjectGradeId, cardSetId])
}

// ─────────────────────────────────────────────
// Decks & FSRS
// ─────────────────────────────────────────────

model Deck {
  id           String     @id @default(uuid())
  enrollmentId String     @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])

  // Per-deck FSRS parameters. "w" = 19 FSRS v5 weight values; empty array = use published defaults
  // from shared/fsrs/constants.ts. newCardsPerDay controls daily new-card introduction limit.
  fsrsParams Json @default("{\"requestRetention\":0.9,\"maximumInterval\":36500,\"w\":[],\"newCardsPerDay\":10}")

  instances CardInstance[]
  sessions  ReviewSession[]
  createdAt DateTime        @default(now())
}

model CardInstance {
  id     String @id @default(uuid())
  deckId String
  deck   Deck   @relation(fields: [deckId], references: [id])
  cardId String
  card   Card   @relation(fields: [cardId], references: [id])

  // Student override of exampleSentence. If null, fall back to Card.exampleSentence at render time.
  exampleSentence String?

  // Student override of definitionL1 (native-language definition). If null, fall back
  // to Card.definitionL1 at render time. Same pattern as exampleSentence — per-student,
  // never visible to or shared with other students who have this same Card.
  definitionL1 String?

  // How this instance arrived in the student's deck
  origin CardOrigin @default(TEACHER_ASSIGNED)

  // FSRS state
  stability      Float     @default(0)
  difficulty     Float     @default(0)
  retrievability Float     @default(0)
  due            DateTime  @default(now())
  lastReview     DateTime?
  reps           Int       @default(0)
  lapses         Int       @default(0)
  state          FSRSState @default(NEW)
  bestStage      Int?      // Historical highest Ebbinghaus stage (0..8); null = uncollected

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reviewEvents ReviewEvent[]

  @@unique([deckId, cardId])
  @@index([deckId, state, due])
  @@index([deckId, bestStage(sort: Desc), id])
}

// ─────────────────────────────────────────────
// Homework Requirements
// ─────────────────────────────────────────────

model HomeworkRequirement {
  id                 String    @id @default(uuid())
  classId            String
  class              Class     @relation(fields: [classId], references: [id])
  sessionsRequired   Int       // e.g. 3
  minCardsPerSession Int       // e.g. 10 — sessions below this threshold don't count
  periodDays         Int       @default(7) // 7 = weekly
  alertThresholdDays Int       @default(2) // flag At Risk when N days remain and requirement not met
  activeFrom         DateTime
  activeTo           DateTime? // null = ongoing
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  // Only one HomeworkRequirement per class may have isActive = true at a time.
  // Enforced at app layer: deactivate existing active requirement within a transaction before creating new one.

  // Optional CardSet focus — empty means "any assigned cardsets" (the student's
  // whole queue). When set, steers (never blocks) the student's default study
  // queue toward these CardSets. See server/src/services/homework.service.ts.
  cardSets HomeworkRequirementCardSet[]
}

model HomeworkRequirementCardSet {
  id                    String              @id @default(uuid())
  homeworkRequirementId String
  homeworkRequirement   HomeworkRequirement @relation(fields: [homeworkRequirementId], references: [id])
  cardSetId             String
  cardSet               CardSet             @relation(fields: [cardSetId], references: [id])

  @@unique([homeworkRequirementId, cardSetId])
}

// ─────────────────────────────────────────────
// Review Stats
// ─────────────────────────────────────────────

model ReviewSession {
  id            String    @id @default(uuid())
  deckId        String
  deck          Deck      @relation(fields: [deckId], references: [id])
  startedAt     DateTime
  endedAt       DateTime? // null = session abandoned or in progress
  cardsReviewed Int       @default(0)
  accuracyRate  Float?    // calculated on session end (correct grades / total grades)
  // Ordered card-instance ids for this session. Lets a refreshed/backgrounded
  // client resume the exact remaining queue instead of starting a new session.
  queue         Json?
  events        ReviewEvent[]
}

model ReviewEvent {
  id             String        @id @default(uuid())
  sessionId      String
  session        ReviewSession @relation(fields: [sessionId], references: [id])
  cardInstanceId String
  cardInstance   CardInstance  @relation(fields: [cardInstanceId], references: [id])
  grade          Int           // FSRS grades: 1 (Again) 2 (Hard) 3 (Good) 4 (Easy)
  responseTimeMs Int?
  submissionId   String?
  reviewedAt     DateTime      @default(now())

  @@unique([sessionId, submissionId])
}

// ─────────────────────────────────────────────
// Gamification ledger
// ─────────────────────────────────────────────

enum RewardType {
  XP
  COIN
}

model RewardEvent {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  // Stable business key; the unique constraint below is the idempotency guard.
  eventKey   String
  rewardType RewardType
  amount     Int
  reason     String
  // Asia/Shanghai calendar date, stored as YYYY-MM-DD so day boundaries and
  // daily caps never depend on the database session timezone.
  studyDate  String
  createdAt  DateTime   @default(now())

  @@unique([userId, eventKey, rewardType])
  @@index([userId, studyDate])
}

// ─────────────────────────────────────────────
// Daily study tasks & levels (Word Camp §4.1)
// ─────────────────────────────────────────────

enum DailyTaskStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum DailyTaskWordKind {
  NEW
  REVIEW
}

enum StudyLevel {
  L1
  L2
  L3
  L5
  BOSS
  REVIEW
}

enum LevelSessionState {
  IN_PROGRESS
  COMPLETED
}

enum LevelQuestionType {
  L2
  L3
  L5
}

model DailyStudyTask {
  id            String          @id @default(uuid())
  enrollmentId  String
  enrollment    Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  studyDate     String          // Asia/Shanghai YYYY-MM-DD
  campDay       Int?            // 1..23 camp map day index
  status        DailyTaskStatus @default(ACTIVE)
  version       Int             @default(1)
  newWordTarget Int
  reviewTarget  Int
  config        Json
  createdAt     DateTime        @default(now())
  completedAt   DateTime?
  words         DailyTaskWord[]
  sessions      LevelSession[]

  @@unique([enrollmentId, studyDate])
  @@index([enrollmentId, status])
}

model DailyTaskWord {
  id                 String            @id @default(uuid())
  taskId             String
  task               DailyStudyTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  cardInstanceId     String
  cardId             String
  kind               DailyTaskWordKind
  sortOrder          Int
  word               String
  pos                String?
  ipa                String?
  definitionL2       String?
  definitionL1       String?
  variants           String[]          @default([])
  exampleSentence    String?
  mnemonic           Json?
  scheduledAt        DateTime?
  scheduledRating    Int?
  scheduledSessionId String?
  questions          LevelQuestion[]

  @@unique([taskId, cardInstanceId])
  @@index([taskId, kind, sortOrder])
}

model LevelSession {
  id                String            @id @default(uuid())
  taskId            String
  task              DailyStudyTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  level             StudyLevel
  attemptNo         Int               @default(1)
  state             LevelSessionState @default(IN_PROGRESS)
  sessionVersion    Int               @default(0)
  questionCount     Int               @default(0)
  firstTryCorrect   Int               @default(0)
  eventuallyCorrect Int               @default(0)
  stars             Int               @default(0)
  cleared           Boolean?
  startedAt         DateTime          @default(now())
  endedAt           DateTime?
  questions         LevelQuestion[]
  answers           LevelAnswer[]

  @@unique([taskId, level, attemptNo])
  @@index([taskId, level])
}

model LevelQuestion {
  id                String            @id @default(uuid())
  sessionId         String
  session           LevelSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  taskWordId        String
  taskWord          DailyTaskWord     @relation(fields: [taskWordId], references: [id], onDelete: Cascade)
  questionType      LevelQuestionType
  prompt            String
  pos               String?
  options           Json?
  correctAnswer     String // server-only, never serialized before reveal
  acceptedAnswers   String[]          @default([])
  sortOrder         Int
  attemptsUsed      Int               @default(0)
  hintLevel         Int               @default(0)
  firstTryCorrect   Boolean           @default(false)
  eventuallyCorrect Boolean           @default(false)
  answerRevealed    Boolean           @default(false)
  answeredAt        DateTime?
  answers           LevelAnswer[]

  @@index([sessionId, sortOrder])
}

model LevelAnswer {
  id           String        @id @default(uuid())
  sessionId    String
  session      LevelSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId   String
  question     LevelQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  submissionId String
  answer       String
  correct      Boolean
  attemptNo    Int
  hintLevel    Int
  responseMs   Int?
  submittedAt  DateTime      @default(now())

  @@unique([sessionId, submissionId])
  @@index([sessionId, questionId])
}

// ─────────────────────────────────────────────
// Hot-Update Releases & Push Notifications
// ─────────────────────────────────────────────

enum ReleasePushMode {
  BANNER
  FORCE_RELOAD
  SILENT
}

enum ReleasePayloadType {
  APP_UI
  VOCAB_PACK
  MNEMONIC_PATCH
  GAME_CONFIG
  WORLD_CONTENT
}

model AppRelease {
  id            String             @id @default(uuid())
  version       String
  packVersion   String             @map("pack_version")
  title         String
  notes         String
  pushMode      ReleasePushMode    @default(BANNER) @map("push_mode")
  payloadType   ReleasePayloadType @default(VOCAB_PACK) @map("payload_type")
  configPayload Json?              @map("config_payload")
  scope         Json?              @map("scope")
  isActive      Boolean            @default(true) @map("is_active")
  publishedBy   String             @map("published_by")
  publisherRole String             @map("publisher_role")
  publishedAt   DateTime           @default(now()) @map("published_at")

  @@index([isActive, publishedAt])
  @@map("app_releases")
}

// ─────────────────────────────────────────────
// Stage 3 Gamification (G0, F1–F12)
// ─────────────────────────────────────────────

model GameEvent {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      String
  sourceId  String
  xp        Int
  // Immutable conversion rate at XP settlement. Legacy events permanently use 0.1.
  sugarCrystalRatio Decimal @default(0.1) @db.Decimal(5, 4)
  localDate String   // Asia/Shanghai YYYY-MM-DD
  meta      Json?
  createdAt DateTime @default(now())

  @@unique([studentId, type, sourceId])
  @@index([studentId, localDate])
  @@index([localDate])
}

// Each purchased level is permanent. Sum(cost) is the only persisted currency debit.
// Free campfire/hatchery are unconditional initial entitlements in shared/world.ts.
model StudentHomeBuilding {
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  buildingKey String
  level       Int
  cost        Int
  requestId   String   // Idempotency-Key UUID, stable across HTTP retries and enrollments
  builtAt     DateTime @default(now())

  @@id([studentId, buildingKey, level])
  @@unique([studentId, requestId])
}

model StudentGameProfile {
  studentId        String   @id
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  nickname         String?
  avatarKey        String   @default("vanilla")
  avatarFrame      String   @default("vanilla")
  cardSkin         String   @default("classic")
  soundEnabled     Boolean  @default(false)
  fontScale        String   @default("normal")
  reduceMotion     Boolean  @default(false)
  lowSpecMode      Boolean  @default(false)
  unlockedSkins    String[] @default([])
  totalXp          Int      @default(0)
  level            Int      @default(1)
  streakDays       Int      @default(0)
  longestStreak    Int      @default(0)
  freezeTickets    Int      @default(0)
  lastAchievedDate String?
  streakCursorDate String?
  lastStudiedDate  String?
  updatedAt        DateTime @updatedAt
}

model DailyGameState {
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  localDate       String   // Asia/Shanghai YYYY-MM-DD
  xpEarned        Int      @default(0)
  reviewDue       Int      @default(0)
  reviewDone      Int      @default(0)
  reviewedCardIds String[] @default([])
  levelsPassed    String[] @default([])
  ringsClosed     Boolean  @default(false)
  weakBossDone    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@id([studentId, localDate])
}

model StudentBadge {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badgeKey  String
  earnedAt  DateTime @default(now())

  @@unique([studentId, badgeKey])
}

model ClassGameSetting {
  classId              String   @id
  class                Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  leaderboardOpen      Boolean  @default(false)
  weeklyTargetCards    Int      @default(300)
  mnemonicCoCreateOpen Boolean  @default(false)
  squadEnabled         Boolean  @default(false)
  activePackId         String?
  updatedAt            DateTime @updatedAt
}

model ClassChallenge {
  id          String   @id @default(uuid())
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  weekStart   String   // Monday YYYY-MM-DD (Asia/Shanghai)
  title       String   @default("本周全班挑战")
  targetCount Int
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([classId, weekStart])
}

model TeacherCheer {
  id         String             @id @default(uuid())
  classId    String
  class      Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  senderId   String
  senderName String
  studentId  String?            // null = whole class
  presetKey  String
  message    String
  sticker    String
  createdAt  DateTime           @default(now())
  reads      TeacherCheerRead[]

  @@index([classId, createdAt])
}

model TeacherCheerRead {
  cheerId   String
  cheer     TeacherCheer @relation(fields: [cheerId], references: [id], onDelete: Cascade)
  studentId String
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  readAt    DateTime     @default(now())

  @@id([cheerId, studentId])
}

// ─────────────────────────────────────────────
// Stage 4 Retention, Analytics, Scale & Content (R2–R11)
// ─────────────────────────────────────────────

model AnalyticsEvent {
  id            String   @id @default(uuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId       String?
  class         Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  clientEventId String
  type          String
  props         Json?
  clientVersion String?
  occurredAt    DateTime @default(now())
  dayKey        String   // Asia/Shanghai YYYY-MM-DD

  @@unique([studentId, clientEventId])
  @@index([classId, dayKey, type])
  @@index([studentId, dayKey])
  @@index([dayKey])
}

model AnalyticsDailyRollup {
  id             String   @id @default(uuid())
  classId        String
  dayKey         String
  type           String
  eventCount     Int
  uniqueStudents Int
  archivedAt     DateTime @default(now())

  @@unique([classId, dayKey, type])
  @@index([dayKey])
}

model PushSubscription {
  id         String    @id @default(uuid())
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([studentId])
}

model ReminderPref {
  studentId           String   @id
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enabled             Boolean  @default(false)
  hour                Int      @default(19)
  pausedUntil         String?  // Asia/Shanghai YYYY-MM-DD
  consecutiveUnopened Int      @default(0)
  updatedAt           DateTime @updatedAt
}

model ReminderLog {
  id         String    @id @default(uuid())
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  templateId String
  channel    String    @default("WEB_PUSH") // WEB_PUSH | IN_APP | TEACHER_CHEER
  localDate  String    // Asia/Shanghai YYYY-MM-DD
  weekStart  String    // Monday YYYY-MM-DD
  sentAt     DateTime  @default(now())
  openedAt   DateTime?

  @@index([studentId, localDate])
  @@index([studentId, weekStart])
}

model MnemonicEntry {
  id             String    @id @default(uuid())
  word           String
  campDay        Int?
  source         String    // TEACHER | IMPORT | STUDENT
  status         String    @default("DRAFT") // DRAFT | PENDING | APPROVED | REJECTED
  authorId       String?
  authorRole     String    // TEACHER | ADMIN | STUDENT
  authorNickname String?   // Only nickname exposed for approved student entries
  reviewerId     String?
  reviewNote     String?
  batchId        String?
  tag            String
  hook           String
  story          String
  chunks         Json
  trap           String?
  example        String?
  releaseVersion String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  reviewedAt     DateTime?

  @@index([word, status])
  @@index([status, campDay])
  @@index([batchId])
}

model Squad {
  id         String        @id @default(uuid())
  classId    String
  class      Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime      @default(now())
  archivedAt DateTime?
  members    SquadMember[]
  weeks      SquadWeek[]
  cheers     SquadCheer[]

  @@index([classId, archivedAt])
}

model SquadMember {
  id        String    @id @default(uuid())
  squadId   String
  squad     Squad     @relation(fields: [squadId], references: [id], onDelete: Cascade)
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  @@unique([squadId, studentId])
  @@index([studentId, leftAt])
}

model SquadWeek {
  id         String    @id @default(uuid())
  squadId    String
  squad      Squad     @relation(fields: [squadId], references: [id], onDelete: Cascade)
  weekStart  String    // Monday YYYY-MM-DD (Asia/Shanghai)
  achieved   Boolean   @default(false)
  achievedAt DateTime?

  @@unique([squadId, weekStart])
}

model SquadCheer {
  id              String   @id @default(uuid())
  squadId         String
  squad           Squad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  senderStudentId String
  sender          Student  @relation(fields: [senderStudentId], references: [id], onDelete: Cascade)
  presetKey       String
  message         String
  sticker         String
  localDate       String   // Asia/Shanghai YYYY-MM-DD
  weekStart       String
  createdAt       DateTime @default(now())

  @@index([squadId, weekStart])
  @@index([senderStudentId, localDate])
}

model ClassSeason {
  id        String   @id @default(uuid())
  classId   String   @unique
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  name      String   @default("中考冲刺赛季")
  examDate  String   // YYYY-MM-DD
  startDate String   // YYYY-MM-DD
  status    String   @default("AUTO") // AUTO | ACTIVE | PAUSED | ENDED
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model WeeklyReport {
  id          String   @id @default(uuid())
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  weekStart   String   // Monday YYYY-MM-DD
  payload     Json
  generatedAt DateTime @default(now())

  @@unique([classId, weekStart])
}

model VocabPack {
  id          String          @id @default(uuid())
  slug        String          @unique
  name        String
  description String?
  daysCount   Int             @default(1)
  isBuiltin   Boolean         @default(false)
  createdBy   String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  items       VocabPackItem[]
}

model VocabPackItem {
  id        String    @id @default(uuid())
  packId    String
  pack      VocabPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  day       Int       @default(1)
  word      String
  ipa       String?
  meaning   String
  mnemonic  Json?
  sortOrder Int       @default(0)

  @@unique([packId, word])
  @@index([packId, day])
}
